{
  "name": "eun-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n auth,app \"npm:emulators\" \"vite --mode emulator --host 127.0.0.1\"",
    "dev:cloud": "vite --host 127.0.0.1",
    "emulators": "firebase emulators:start --only auth --project demo-eun-v3",
    "build": "tsc -b && vite build",
    "build:deploy": "node scripts/check-deploy.mjs && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "exceljs": "^4.4.0",
    "firebase": "^13.3.0",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "fake-indexeddb": "^6.2.8",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
